; Project Fledge learning proof. Open this file in Godot 4.6 or later.
config_version=5

[application]
config/name="Fledge Teaching Room"
run/main_scene="res://teaching_room.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=880
window/size/viewport_height=630
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.06, 0.085, 0.12, 1)
